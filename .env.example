# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 절대 공개 저장소에 올리지 마세요 (봇 토큰이 노출되면 누구나 봇을 조작할 수 있습니다).
#
# 콘솔에서 아래를 실행하면 차례로 물어보고 자동으로 채워 줍니다.
#     python -m meralarm --setup
#
# 알림 받을 곳은 하나만 있어도 됩니다. 텔레그램과 디스코드 중 하나만 채우셔도 돌아갑니다.

# --- 텔레그램 ---
# @BotFather 에서 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# 봇에게 아무 메시지나 보내면 --setup 이 알아서 찾아줍니다.
TELEGRAM_CHAT_ID=

# --- 디스코드 (선택) ---
# 아래 두 가지 중 하나만 쓰면 됩니다. 둘 다 채우면 봇만 씁니다(알림 중복 방지).
#
# [웹훅] 알림만 받습니다. 명령어는 쓸 수 없습니다.
#   채널 옆 톱니 -> 연동 -> 웹후크 -> 새 웹후크 -> 웹후크 URL 복사
DISCORD_WEBHOOK_URL=

# [봇] 알림에 더해 /add 같은 명령도 씁니다.
#   https://discord.com/developers/applications -> New Application
#   -> 왼쪽 Bot -> Reset Token -> 나온 값
DISCORD_BOT_TOKEN=

# 알림을 띄울 채널 번호. --setup 이 목록에서 고르게 해 줍니다.
DISCORD_CHANNEL_ID=

# 이 사람만 명령을 쓸 수 있습니다. 보통 서버를 만든 본인입니다.
# 직접 찾으려면 디스코드 설정 -> 고급 -> 개발자 모드를 켜고 이름 우클릭 -> 사용자 ID 복사
DISCORD_OWNER_ID=
