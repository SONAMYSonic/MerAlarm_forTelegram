# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 절대 공개 저장소에 올리지 마세요 (봇 토큰이 노출되면 누구나 봇을 조작할 수 있습니다).

# @BotFather 에서 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# 비워두고 telegram_check.py 를 실행하면 자동으로 찾아줍니다.
TELEGRAM_CHAT_ID=

# (선택) 디스코드에도 함께 보내려면 채워주세요. 비워두면 텔레그램만 씁니다.
# 디스코드에서: 채널 옆 톱니 → 연동 → 웹후크 → 새 웹후크 → 웹후크 URL 복사
DISCORD_WEBHOOK_URL=
