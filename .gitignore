# 비밀값 — 절대 공유 금지
.env

# 플랫폼 종속이라 옮겨봐야 안 돌아간다. 옮긴 곳에서 새로 만든다.
.venv/

# 내 키워드가 담긴 개인 설정. 견본은 config.example.yaml 이고, 없으면 프로그램이
# 처음 켤 때 그것을 복사해 만든다. 커밋해 두면 /add 할 때마다 저장소가 더러워지고,
# 받는 사람에게 남의 키워드가 딸려 간다.
config.yaml

# 실행하면서 쌓이는 것
data/
logs/
.meralarm.lock

# 배포용 묶음 (scripts/pack.ps1 이 만든다)
MerAlarm-deploy.tar.gz
*.tar.gz

# 실행 파일 빌드 결과 (scripts/build_exe.ps1 이 만든다)
build/
dist/
*.spec

__pycache__/
*.py[cod]
